<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="#1E1E24"
    tools:context="com.example.netaudiotalk.ui.MainActivity">

    <!-- 左侧参数控制面板 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="#2B2B36"
        android:layout_marginEnd="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NetAudioTalk 专网配置"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerNetCard"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#FFFFFF"
            android:marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerProtocol"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#FFFFFF"
            android:marginBottom="6dp"/>

        <EditText
            android:id="@+id/etTargetIp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="目标地址/组播(239.0.0.1)"
            android:textColorHint="#888888"
            android:textColor="#000000"
            android:background="#FFFFFF"
            android:paddingStart="8dp"
            android:inputType="text"
            android:marginBottom="6dp"/>

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="端口号(6000)"
            android:textColorHint="#888888"
            android:textColor="#000000"
            android:background="#FFFFFF"
            android:paddingStart="8dp"
            android:inputType="number"
            android:marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgWorkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:marginBottom="6dp">
            <RadioButton
                android:id="@+id/rbPilot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="飞行员(双向)"
                android:textColor="#FFFFFF"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rbObserver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="观察者(静默)"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

        <RadioGroup
            android:id="@+id/rgTalkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:marginBottom="8dp">
            <RadioButton
                android:id="@+id/rbPtt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PTT模式"
                android:textColor="#FFFFFF"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rbContinuous"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="持续发送"
                android:textColor="#FFFFFF"/>
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button
                android:id="@+id/btnSaveParams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="持久化保存"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/btnLoadParams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="读取"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="连接系统"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- 右侧滚动控制台日志与触控大按钮 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.8"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:padding="4dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/etLogWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:text="--- NetAudioTalk 运行控制台日志就绪 ---\n"/>
        </ScrollView>

        <Button
            android:id="@+id/btnTalkLarge"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="按住 对讲 (PTT)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
